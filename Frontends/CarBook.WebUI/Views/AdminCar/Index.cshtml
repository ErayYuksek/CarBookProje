@model List<ResultCarWithBrandsDtos>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}
<div class="page-content">
    <div class="container-fluid">

        <!-- start page title -->

        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Car List Neww</h4>
                        <p class="card-subtitle mb-4">
                            You can perform decryption, update, search, and listing operations related to cars via this page.
                        </p>
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Brand</th>
                                        <th>Model</th>
                                        <th>Transmission</th>
                                        <th>Miles</th>
                                        <th>Remove</th>
                                        <th>Update</th>
                                        <th>Details</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        count++;
                                        <tr>
                                            <th scope="row">@count</th>
                                            <td>@item.BrandName</td>
                                            <td>@item.Model</td>
                                            <td>@item.Transmission</td>
                                            <td>@item.Km</td>
                                            <td>
                                                <a href="/AdminCar/RemoveCar/@item.CarID" class="btn btn-outline-danger">Remove</a>
                                            </td>
                                            <td>
                                                <a href="/AdminCar/UpdateCar/@item.CarID" class="btn btn-outline-success">Update</a>
                                            </td>
                                            <td>
                                                <a href="/CarList/CarDetail/@item.CarID" class="btn btn-outline-dark">Details</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <a href="/AdminCar/CreateCar" class="btn btn-outline-primary mt-3">New Car</a>
                        </div> <!-- end table-responsive -->
                    </div> <!-- end card-body -->
                </div> <!-- end card -->
            </div> <!-- end col -->
        </div> <!-- end row -->

    </div> <!-- container-fluid -->
</div> <!-- end page-content -->
