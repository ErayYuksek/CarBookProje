@model UpdateCarDto

@{
    ViewData["Title"] = "UpdateCar";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}


<div class="page-content">
    <div class="container-fluid">

        <!-- start page title -->

        <div class="row">
            <div class="col-xl-12">


                <div class="card">
                    <div class="card-body">

                        <h4 class="card-title">Update vehicle entry</h4>
                        <p class="card-subtitle mb-4">Fill in the basic update about the vehicle.</p>
                        <form method="post">
                            <input type="hidden" asp-for="CarID" />
                            <div class="form-group">
                                <label for="exampleInputBrand">Brand</label>

                                @Html.DropDownListFor(x => x.BrandID, ViewBag.Brands as SelectList, "YOUR CHOICE", new { @class = "form-control" })



                                <div class="form-group">
                                    <label>Model</label>
                                    <input type="text" class="form-control" placeholder="Enter The Model" asp-for="Model">
                                </div>
                                <div class="form-group">
                                    <label>Cover Photo</label>
                                    <input type="text" class="form-control" placeholder="Enter the Vehicle Cover Photo" asp-for="CoverImageUrl">
                                </div>
                                <div class="form-group">
                                    <label>Big Photo</label>
                                    <input type="text" class="form-control" placeholder="Enter the Vehicle Cover Photo" asp-for="BigImageUrl">
                                </div>
                                <div class="form-group">
                                    <label>Mil</label>
                                    <input type="number" class="form-control" placeholder="Enter the Vehicle Mileage Information" asp-for="Km">
                                </div>
                                <div class="form-group">
                                    <label>Type of Gear</label>
                                    <input type="text" class="form-control" placeholder="Enter the Vehicle Gear Type" asp-for="Transmission">
                                </div>
                                <div class="form-group">
                                    <label>Number of Seats</label>
                                    <input type="number" class="form-control" placeholder="Enter the Number of Vehicle Seats" asp-for="Seat">
                                </div>
                                <div class="form-group">
                                    <label>Number of Luggage</label>
                                    <input type="number" class="form-control" placeholder="Enter the Number of Car Luggage" asp-for="Luggage">
                                </div>
                                <div class="form-group">
                                    <label>type of fuel</label>
                                    <input type="text" class="form-control" placeholder="Enter the Vehicle Fuel Type" asp-for="Fuel">
                                </div>
                                <br />
                                <button type="submit" class="btn btn-primary waves-effect waves-light">Car Save</button>
                                <a href="/Admin/AdminCar/Index/" class="btn btn-danger waves-effect waves-light">Cancel</a>
                        </form>

                    </div> <!-- end card-body-->
                </div>

            </div> <!-- end card-body -->
        </div> <!-- end card -->
    </div> <!-- end col -->
</div> <!-- end row -->
