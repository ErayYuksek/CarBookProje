@model CreateCarDto
@{
    ViewData["Title"] = "CreateCar";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">

        <!-- start page title -->

        <div class="row">
            <div class="col-xl-12">


                <div class="card">
                    <div class="card-body">

                        <h4 class="card-title">New vehicle entry</h4>
                        <p class="card-subtitle mb-4">Fill in the basic information about the vehicle.</p>
                        <form method="post">
                            <div class="form-group">
                                <label for="exampleInputBrand">Brand</label>

                                @Html.DropDownListFor(x => x.BrandID, (List<SelectListItem>)ViewBag.BrandValues, "Seçiniz", new { @class = "form-control" })




                                <small id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small>
                            </div>
                            <div class="form-group">
                                <label for="exampleInputModel">Model</label>
                                <input type="password" class="form-control" id="exampleInputModel" placeholder="Model">
                            </div>

                            <div class="form-group">
                                <label for="exampleInputModel">Model</label>
                                <input type="password" class="form-control" id="exampleInputModel" placeholder="Model">
                            </div>


                            <div class="form-group">
                                <label for="exampleInputModel">Model</label>
                                <input type="password" class="form-control" id="exampleInputModel" placeholder="Model">
                            </div>




                            <div class="form-group">
                                <label for="exampleInputModel">Model</label>
                                <input type="password" class="form-control" id="exampleInputModel" placeholder="Model">
                            </div>

                            <div class="form-group">
                                <label for="exampleInputModel">Model</label>
                                <input type="password" class="form-control" id="exampleInputModel" placeholder="Model">
                            </div>


                            <div class="form-group">
                                <label for="exampleInputModel">Model</label>
                                <input type="password" class="form-control" id="exampleInputModel" placeholder="Model">
                            </div>

                            <button type="submit" class="btn btn-primary waves-effect waves-light">Submit</button>
                        </form>

                    </div> <!-- end card-body-->
                </div>

            </div> <!-- end card-body -->
        </div> <!-- end card -->
    </div> <!-- end col -->
</div> <!-- end row -->
