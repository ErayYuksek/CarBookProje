@model List<ResultFeatureDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}
<div class="page-content">
    <div class="container-fluid">

        <!-- start page title -->

        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Car Specifications</h4>
                        <p class="card-subtitle mb-4">
                            Specifications list
                        </p>
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Specifications</th>

                                        <th>Remove</th>
                                        <th>Update</th>
                                    
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        count++;
                                        <tr>
                                            <th scope="row">@count</th>
                                            <td>@item.Name</td>

                                            <td><a href="/AdminFeature/RemoveFeature/@item.FeatureID" class="btn btn-danger">Sil</a></td>
                                            <td><a href="/AdminFeature/UpdateFeature/@item.FeatureID" class="btn btn-secondary">Güncelle</a></td>
                                            <td>
                             
                                        </tr>
                                    }
                                  
                                </tbody>
                            </table>
                            <a href="/AdminFeature/CreateFeature" class="btn btn-outline-primary mt-3">Specifications Car</a>
                        </div> <!-- end table-responsive -->
                    </div> <!-- end card-body -->
                </div> <!-- end card -->
            </div> <!-- end col -->
        </div> <!-- end row -->

    </div> <!-- container-fluid -->
</div> <!-- end page-content -->
