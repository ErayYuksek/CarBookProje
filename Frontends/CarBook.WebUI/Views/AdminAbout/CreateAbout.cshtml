@model CreateAboutDto
@{
    ViewData["Title"] = "CreateAbout";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}



<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Hakkımızda Veri Girişi Alanı</h4>
                        <p class="card-subtitle mb-4">
                            Ana sayfanız ve Hakkımızda sayfasının hakkında bulunan bilgileri aşağıdan düzenleyebilirsiniz. Tema bütünlüğünün bozulmaması adına lütfen sadece 1 tane veri girişi yapınız. Aksi durumlarda tema bütünlüğü bozulacaktır.
                        </p>

                        <form method="post">
                            <div class="form-group">
                                <label for="exampleInputTitle">Başlık</label>
                                <input type="text" class="form-control" asp-for="title" placeholder="Başlığı Giriniz">
                             </div>

                            <div class="form-group">
                                <label for="exampleInputDescription">Açıklama</label>
                                <textarea rows="5" class="form-control" asp-for="description" placeholder="Açıklamayı Giriniz"></textarea>
                            </div>

                            <div class="form-group">
                                <label for="exampleInputImageUrl">Video Açıklama</label>
                                <input type="text" class="form-control" asp-for="imageUrl" placeholder="Hakkında Kapak Fotoğraf Linkini Giriniz">
                            </div>

                            <button type="submit" class="btn btn-primary waves-effect waves-light">Hakkında Bilgisini Kaydet</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>