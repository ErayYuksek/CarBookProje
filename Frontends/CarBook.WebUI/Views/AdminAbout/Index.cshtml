@model List<ResultAboutDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}




<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Ana Sayfa About Alanı</h4>
                <p class="card-subtitle mb-4">Ana sayfanın About alanında bulunan bilgileri aşağıdan düzenleyebilirsiniz. <span class="text-danger">Tema bütünlüğü için lütfen 1 adet About alanı giriniz.</span></p>
                <div class="table-responsive">
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th>Başlık</th>
                                    <th>Açıklama</th>
                                    <th>Görsel</th>
                        
                                    <th>Sil</th>
                                    <th>Güncelle</th>
                 
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.title</td>
                                        <td>@item.description</td>
                                        <td>@item.imageUrl</td>

                                        <td><a href="/AdminAbout/RemoveAbout/@item.aboutID" class="btn btn-danger">Sil</a></td>
                                        <td><a href="/Admin/AdminAbout/UpdateAbout/@item.aboutID" class="btn btn-secondary">Güncelle</a></td>
                                      
                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>
                    <br />
                    <a href="/AdminAbout/CreateAbout/" class="btn btn-success">Yeni About Girişi</a>
                </div>
            </div>
        </div>
    </div>
</div>