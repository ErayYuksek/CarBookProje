@model CreatePricingDto
@{
    ViewData["Title"] = "CreatePricing";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Yeni Ödmeme Bilgisi Girişi</h4>
                        <p class="card-subtitle">Ödeme grişi yapınız</p>

                        <form method="post">
                            <div class="form-group">
                                <label for="exampleInputName">Ödeme</label>
                                <input type="text" class="form-control" id="exampleInputName" asp-for="Name" placeholder="Günlük Haftalık Aylık Giriniz">
                            </div>
                            <button type="submit" class="btn btn-primary waves-effect waves-light">Ödeme Periyot Bilgisini Kaydet</button>
                          
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
