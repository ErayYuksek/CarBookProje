@model List<ResultPricingDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count= 0;
}




<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Ödeme Türü  Alanı</h4>
                <p class="card-subtitle mb-4">Ana sayfanın Pricing alanında bulunan bilgileri aşağıdan düzenleyebilirsiniz. <span class="text-danger">Tema bütünlüğü için lütfen 1 adet Pricing alanı giriniz.</span></p>
                <div class="table-responsive">
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th>#</th>
                                    <th>Periyot Adı</th>
                                    <th>Sil</th>
                                    <th>Güncelle</th>
                         
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <td>@count</td>
                                        <td>@item.Name</td>
                                  
                                        <td><a href="/AdminPricing/RemovePricing/@item.PricingID" class="btn btn-danger">Sil</a></td>
                                        <td><a href="/AdminPricing/UpdatePricing/@item.PricingID" class="btn btn-secondary">Güncelle</a></td>
                  
                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>
                    <br />
                    <a href="/AdminPricing/CreatePricing/" class="btn btn-success">Yeni Ödeme  Girişi</a>
                </div>
            </div>
        </div>
    </div>
</div>