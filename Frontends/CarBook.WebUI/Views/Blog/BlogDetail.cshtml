
@{
    ViewData["Title"] = "BlogDetail";
    Layout = "~/Views/UILayout/Index.cshtml";
}

 <section class="ftco-section ftco-degree-bg">
   <div class="container">
     <div class="row">
        @if (ViewBag.BlogId != null)
{
                @await Component.InvokeAsync("_BlogDetailsMainComponentPartial", new { id = ViewBag.BlogId })
}
else
{
    <p style="color:red">BlogId bulunamadı.</p>
}


       <div class="col-md-4 sidebar ftco-animate">

                @await Component.InvokeAsync("_BlogDetailSideSearchBoxComponentPartial")

                @await Component.InvokeAsync("_BlogDetailCategoryComponentPartial")


                @await Component.InvokeAsync("_BlogsDetailRecentBlogsComponentPartial")

               @*  @await Component.InvokeAsync("_BlogDetailsMainComponentPartial", new { id = ViewBag.BlogId }) *@
         

                @await Component.InvokeAsync("_BlogDetailsParagrafComponentPartial")


       </div>

     </div>
   </div>
 </section>